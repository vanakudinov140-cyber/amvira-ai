# === BACKEND (Amvera → retention API project, корень репозитория) ===
# Скопируйте в Amvera → Переменные / Секреты
# PostgreSQL — отдельный managed-проект; хост только внутренний *-rw

ENVIRONMENT=production

# ОБЯЗАТЕЛЬНО — внутренний хост из карточки PostgreSQL (НЕ localhost):
# amvera-<user>-cnpg-<pg_project>-rw
DATABASE_URL=postgresql+asyncpg://<db_user>:<url_encoded_password>@amvera-<user>-cnpg-<pg_project>-rw:5432/<db_name>

TEST_MODE=true
TEST_RECIPIENTS=79990000000,79990000001

LOG_LEVEL=INFO
DEBUG=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_TEST_CHAT_ID=

YCLIENTS_API_KEY=
YCLIENTS_PARTNER_TOKEN=
YCLIENTS_COMPANY_ID=0
# YCLIENTS_BASE_URL=https://api.yclients.com/api/v1

FLOWSELL_API_URL=
FLOWSELL_API_KEY=

SCHEDULER_AUTOMATION_ENABLED=true
SEND_PENDING_LIMIT=5
RETENTION_ATTRIBUTION_DAYS=30
DUPLICATE_WINDOW_DAYS=7
RETENTION_COOLDOWN_DAYS=14
DAILY_SEND_LIMIT=50
QUIET_HOURS_START=21
QUIET_HOURS_END=10

AI_REWRITE_ENABLED=false
AI_PROVIDER=mock

# Если admin-dashboard на отдельном домене (опционально, regex *.amvera.* уже есть)
CORS_ORIGINS=https://retention-admin-ivankudinov.amvera.app

# НЕ задавайте POSTGRES_HOST / POSTGRES_* — fallback localhost ломает Amvera

# ROOT_PATH=   # обычно пусто
