# Скопируйте переменные в Amvera → Проект приложения → Переменные / Секреты
# PostgreSQL создаётся отдельным проектом в Amvera (managed cluster).

# --- Обязательно ---
# Внутренний хост БД из карточки PostgreSQL (чтение/запись), порт обычно 5432:
# amvera-<user>-cnpg-<project>-rw
DATABASE_URL=postgresql+asyncpg://<db_user>:<db_password>@amvera-<user>-cnpg-<pg_project>-rw:5432/<db_name>

# Публичный URL приложения (для CORS, если открываете API отдельно; при same-origin через nginx можно оставить пустым)
# CORS_ORIGINS=https://<your-app>.amvera.app

LOG_LEVEL=INFO
DEBUG=false

# --- TEST MODE (сохраняем для demo/production-test) ---
TEST_MODE=true
TEST_RECIPIENTS=79990000000,79990000001

TELEGRAM_BOT_TOKEN=
TELEGRAM_TEST_CHAT_ID=

# --- YCLIENTS ---
YCLIENTS_API_KEY=
YCLIENTS_PARTNER_TOKEN=
YCLIENTS_COMPANY_ID=0

# --- FlowSell ---
FLOWSELL_API_URL=
FLOWSELL_API_KEY=

# --- Retention / scheduler ---
SEND_PENDING_LIMIT=5
SCHEDULER_AUTOMATION_ENABLED=true
RETENTION_ATTRIBUTION_DAYS=30
DUPLICATE_WINDOW_DAYS=7
RETENTION_COOLDOWN_DAYS=14
DAILY_SEND_LIMIT=50
QUIET_HOURS_START=21
QUIET_HOURS_END=10

AI_REWRITE_ENABLED=false
AI_PROVIDER=mock

# Frontend label (собирается в Docker; для смены — пересборка)
# VITE_ENV_LABEL=Тестовый режим
