# Application
APP_NAME=AI Retention API
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# PostgreSQL (used by docker-compose for the db service)
POSTGRES_USER=retention
POSTGRES_PASSWORD=retention
POSTGRES_DB=retention

# Async SQLAlchemy URL (asyncpg driver)
# Local (host machine): localhost
# Docker Compose: hostname is the service name `db`
DATABASE_URL=postgresql+asyncpg://retention:retention@localhost:5432/retention

# YCLIENTS (https://developers.yclients.com/)
YCLIENTS_API_KEY=
YCLIENTS_PARTNER_TOKEN=
YCLIENTS_COMPANY_ID=
# optional override
# YCLIENTS_BASE_URL=https://api.yclients.com/api/v1

# FlowSell (единая точка отправки; MVP: POST {FLOWSELL_API_URL}/messages)
FLOWSELL_API_URL=
FLOWSELL_API_KEY=

# TEST MODE: send-pending не идёт на телефоны клиентов; доставка в Telegram (см. ниже)
TEST_MODE=false
TEST_RECIPIENTS=79990000000,79990000001

# Telegram Bot API для реальной TEST-доставки (при TEST_MODE=true)
TELEGRAM_BOT_TOKEN=
TELEGRAM_TEST_CHAT_ID=

# Доп. CORS origins (через запятую), напр. https://your-app.amvera.app
# На Amvera с nginx same-origin обычно не требуется.
CORS_ORIGINS=

# Amvera production: ENVIRONMENT=production + DATABASE_URL с хостом *-cnpg-*-rw
# НЕ используйте localhost на Amvera. См. deploy/AMVERA_ENV.md

# Максимум сообщений за один вызов POST /messages/send-pending
SEND_PENDING_LIMIT=5
SCHEDULER_AUTOMATION_ENABLED=true

# Return attribution window (days after sent_at for client_returned)
RETENTION_ATTRIBUTION_DAYS=30

# Retention messaging safeguards
DUPLICATE_WINDOW_DAYS=7
RETENTION_COOLDOWN_DAYS=14
DAILY_SEND_LIMIT=50
QUIET_HOURS_START=21
QUIET_HOURS_END=10

# AI rewrite layer for retention messages
AI_REWRITE_ENABLED=false
AI_PROVIDER=mock
