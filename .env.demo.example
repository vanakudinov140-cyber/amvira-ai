# Пример для именованного Cloudflare Tunnel (стабильнее quick tunnel)
# 1. https://one.dash.cloudflare.com → Zero Trust → Networks → Tunnels → Create
# 2. Public hostname: retention-demo → http://localhost:8080
# 3. Скопируйте token сюда:
CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token_here

# Запуск:
#   docker compose -f docker-compose.demo.yml --profile named-tunnel up -d
