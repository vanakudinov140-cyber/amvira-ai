# Скопируйте в .env.production (не коммитится) или задайте те же ключи в панели Amvera → Переменные.
# Секреты храните как «Секреты» в Amvera, не в git.

NODE_ENV=production
# Amvera обычно пробрасывает PORT; при отсутствии используется 3000 из кода
PORT=3000
TRUST_PROXY=true
REQUEST_BODY_LIMIT=512kb

# Обязательно: Prisma + приложение (внутренний RW-хост кластера из карточки PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@amvera-ACCOUNT-cnpg-DBNAME-rw:5432/DB_NAME?schema=public

# Обязательно для GET /health/ready: Redis из отдельного проекта Amvera (внутренний hostname)
REDIS_HOST=amvera-REPLACE-redis-or-addon-host
REDIS_PORT=6379
REDIS_PASSWORD=

ASYNC_JOBS_USE_BULLMQ=false

# Telegram / GigaChat / YCLIENTS — по необходимости функций (см. docs/AMVERA-DEPLOY.md)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
TELEGRAM_MVP_DEFAULT_DIALOG_ID=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SYNC_ON_STARTUP=false

GIGACHAT_AUTHORIZATION_KEY=
GIGACHAT_OAUTH_URL=
GIGACHAT_API_BASE_URL=
GIGACHAT_SCOPE=
GIGACHAT_MODEL=
GIGACHAT_REQUEST_TIMEOUT_MS=60000

SALON_DISPLAY_NAME=Beauty salon

YCLIENTS_API_BASE_URL=
YCLIENTS_PARTNER_TOKEN=
YCLIENTS_COMPANY_ID=
YCLIENTS_USER_TOKEN=
YCLIENTS_REQUEST_TIMEOUT_MS=15000
YCLIENTS_ENABLE_SYNC=false
YCLIENTS_CACHE_TTL_SECONDS=300
