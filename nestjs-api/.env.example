# =============================================================================
# Runtime / HTTP
# =============================================================================
NODE_ENV=development
PORT=3000
# Comma-separated hops or "true" for default (see main.ts trust proxy)
# В Amvera за reverse-proxy обычно TRUST_PROXY=true
TRUST_PROXY=false
# Express JSON body limit (e.g. 512kb, 1mb)
REQUEST_BODY_LIMIT=512kb

# =============================================================================
# Database (required)
# =============================================================================
# Local (host):
# DATABASE_URL=postgresql://salon:salon@localhost:5432/salon?schema=public
# Docker Compose (service name postgres):
DATABASE_URL=postgresql://salon:salon@postgres:5432/salon?schema=public
#
# Amvera (managed PostgreSQL, internal RW host from DB project «Инфо»):
# postgresql://USER:PASSWORD@amvera-<account>-cnpg-<db-name>-rw:5432/DB_NAME?schema=public
# Подключение из интернета (отдельный POSTGRES-домен в Amvera) — нужен SSL, см. docs/AMVERA-DEPLOY.md
# Кодируйте спецсимволы в USER/PASSWORD через URL-encoding (RFC 3986).

# =============================================================================
# Redis / async jobs
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave empty if no password
REDIS_PASSWORD=
# true = BullMQ workers + async channel delivery queue
ASYNC_JOBS_USE_BULLMQ=false

# =============================================================================
# Telegram (webhook MVP)
# =============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
TELEGRAM_MVP_DEFAULT_DIALOG_ID=
# Public HTTPS URL for Telegram to POST updates, e.g. https://your-host/api/channels/telegram/webhook
TELEGRAM_WEBHOOK_URL=
# If true, calls setWebhook on app startup (requires TELEGRAM_WEBHOOK_URL + TELEGRAM_BOT_TOKEN)
TELEGRAM_WEBHOOK_SYNC_ON_STARTUP=false

# =============================================================================
# GigaChat (AI provider)
# =============================================================================
GIGACHAT_AUTHORIZATION_KEY=
GIGACHAT_OAUTH_URL=
GIGACHAT_API_BASE_URL=
GIGACHAT_SCOPE=
GIGACHAT_MODEL=
GIGACHAT_REQUEST_TIMEOUT_MS=60000

# =============================================================================
# Branding / misc
# =============================================================================
SALON_DISPLAY_NAME=Beauty salon
